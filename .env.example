# Copy to .env and fill in. Never commit .env (it is gitignored).

# ─── LLM providers (at least one required) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Primary provider and fallback (provider failover per README).
LLM_PROVIDER=anthropic            # anthropic | openai
LLM_FALLBACK_PROVIDER=openai
LLM_MODEL=claude-sonnet-4-6       # primary (Anthropic) model
OPENAI_MODEL=gpt-4o-mini          # model used when falling back to OpenAI
EMBEDDING_MODEL=text-embedding-3-small

# ─── Qdrant (vector store; docker-compose service) ─────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                   # leave blank for local docker
QDRANT_COLLECTION=requirements

# ─── LangFuse (tracing; docker-compose service) ────────────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
# Server-side secrets consumed by docker-compose (dev defaults — change for any shared use):
LANGFUSE_NEXTAUTH_SECRET=dev-secret-change-me
LANGFUSE_SALT=dev-salt-change-me

# ─── Run budgets / guardrails (agent loop caps) ────────────────────────────
MAX_AGENT_STEPS=12
MAX_TOKENS_PER_RUN=200000
MAX_USD_PER_RUN=0.50
MAX_AUDIT_PAIRS=60                 # cap on candidate pairs sent to the LLM comparator

# ─── Local stores ──────────────────────────────────────────────────────────
SQLITE_PATH=./data/requirements.sqlite
